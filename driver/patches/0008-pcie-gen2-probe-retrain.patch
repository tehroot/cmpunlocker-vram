+static void
+nv_cmp170hx_retrain_gen2(nv_state_t *nv)
+{
+    nv_linux_state_t *nvl = NV_GET_NVL_FROM_NV_STATE(nv);
+    struct pci_dev *gpu = nvl->pci_dev;
+    struct pci_dev *upstream;
+    void __iomem *bar0;
+    u16 gpu_ctl2 = 0, upstream_ctl2 = 0, link_status = 0;
+    u32 gpu_cap = 0, gpu_cap2 = 0, upstream_cap2 = 0;
+
+#ifndef PCI_EXP_LNKCAP_DLLLARC
+#define PCI_EXP_LNKCAP_DLLLARC 0x00100000
+#endif
+
+    /*
+     * LOGGING ONLY. The retrain itself now happens in 0007's GEN2_LATE
+     * block, inside the window where LnkCap2 still reads 0x6 -- doing it
+     * here was too late: the cap has reverted to 0x2 by device init and
+     * every write that could restore it is rejected (0x88xxx PLM-locked,
+     * 0x8c1c0 clamped, LnkCtl2 refused). See docs/16.
+     * This function is kept as the post-init verification dump: it shows
+     * whether the rate established in the window survived to here.
+     */
+    if ((gpu == NULL) ||
+        ((gpu->device != 0x20c2) && (gpu->device != 0x2082)))
+        return;
+
+    upstream = pci_upstream_bridge(gpu);
+
+    (void)pcie_capability_read_dword(gpu, PCI_EXP_LNKCAP, &gpu_cap);
+    (void)pcie_capability_read_dword(gpu, PCI_EXP_LNKCAP2, &gpu_cap2);
+    (void)pcie_capability_read_word(gpu, PCI_EXP_LNKCTL2, &gpu_ctl2);
+    (void)pcie_capability_read_word(gpu, PCI_EXP_LNKSTA, &link_status);
+    if (upstream != NULL)
+    {
+        (void)pcie_capability_read_dword(upstream, PCI_EXP_LNKCAP2, &upstream_cap2);
+        (void)pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2, &upstream_ctl2);
+    }
+
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP Gen2: verify cfg LnkCap=0x%08x LnkCap2=0x%08x LnkCtl2=0x%04x "
+                  "LnkSta=0x%04x speed=%u width=%u DLLLARC=%u | up LnkCap2=0x%08x LnkCtl2=0x%04x\n",
+                  gpu_cap, gpu_cap2, gpu_ctl2, link_status,
+                  link_status & PCI_EXP_LNKSTA_CLS,
+                  (link_status & PCI_EXP_LNKSTA_NLW) >> 4,
+                  (gpu_cap & PCI_EXP_LNKCAP_DLLLARC) ? 1U : 0U,
+                  upstream_cap2, upstream_ctl2);
+
+    bar0 = ioremap(pci_resource_start(gpu, 0), 0x90000);
+    if (bar0 == NULL)
+        return;
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP Gen2: verify bar0 CAP=0x%08x CAP2=0x%08x LC2=0x%08x CYA0=0x%08x "
+                  "CFG0=0x%08x PL=0x%08x MISC1=0x%08x STAT=0x%08x\n",
+                  readl(bar0 + 0x88084), readl(bar0 + 0x880a4),
+                  readl(bar0 + 0x880a8), readl(bar0 + 0x8c2c0),
+                  readl(bar0 + 0x8c040), readl(bar0 + 0x8c1c0),
+                  readl(bar0 + 0x8841c), readl(bar0 + 0x88088));
+    iounmap(bar0);
+}
+
 /*
  * Brings up the device on the first file open. Assumes nvl->ldata_lock is held.
  */
@@ -1530,6 +1595,8 @@
         nv->flags |= NV_FLAG_PERSISTENT_SW_STATE;
     }
 
+    nv_cmp170hx_retrain_gen2(nv);
+
     /* Generate and cache the UUID for future callers */
     (void)rm_get_gpu_uuid_raw(sp, nv);
 
