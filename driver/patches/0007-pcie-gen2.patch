+                                      "SEC2_DEBUG: GEN3_STRAP b%u %s(0x%06x) "
+                                      "pre=0x%08x want=0x%08x post=0x%08x "
+                                      "post2=0x%08x %s "
+                                      "CAP=0x%08x CAP2=0x%08x\n",
