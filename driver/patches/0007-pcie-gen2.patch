+            #define PCIE_GEN2_VSEC_DEVICE_ADDR      0x0008860cU
+            #define PCIE_GEN2_VSEC_HIERARCHY_ADDR   0x00088610U
+            #define PCIE_GEN2_XP3G_OVR_BASE         0x0008e110U
+            #define PCIE_GEN2_XP3G_VAL_BASE         0x0008e120U
