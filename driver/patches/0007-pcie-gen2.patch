+                        NvU32       addr;
+                        NvU32       count;   /* consecutive dwords */
+                        NvU32       value;
+                        const char *name;
+                    } permits[] = {
+                        /* b0 */ { 0x00088c28U, 1, 0x0000000fU, "XVE_C28_vec0f" },
+                        /* b1 */ { 0x00088cd8U, 1, 0x0000000fU, "XVE_CD8_vec0f" },
+                        /* b2 */ { 0x00088d48U, 1, 0x00000003U, "XVE_D48"       },
+                        /* b3 */ { 0x00088ce0U, 1, 0x02100006U, "XVE_CE0"       },
+                        /* b4 */ { 0x00088ce4U, 1, 0x00000014U, "XVE_CE4"       },
+                        /* b5 */ { 0x00088d04U, 1, 0x00030001U, "XVE_D04"       },
+                        /* b6 */ { 0x00088dccU, 1, 0x8000000bU, "XVE_DCC"       },
+                        /* b7 */ { 0x00088c88U, 1, 0x00078004U, "XVE_C88"       },
+                        /* b8 */ { 0x0008890cU, 8, 0x04000400U, "XVE_lane_pre"  },
+                        /* b9 */ { 0x00088c3cU, 4, 0x30303030U, "XVE_lane_c3c"  },
+                        /* b10*/ { 0x00088bc0U, 1, 0x00001101U, "XVE_BC0"       },
+                        /* b11*/ { 0x00088bbcU, 1, 0x003ffc00U, "XVE_BBC"       },
+                        /* b12*/ { 0x00088a00U, 1, 0x00000011U, "XVE_A00"       },
+                        /* b13*/ { 0x0008889cU, 1, 0x00000037U, "XVE_89C"       },
+                        /* b14*/ { 0x00088c14U, 1, 0xc1c1000eU, "XVE_C14"       },
+                        /* b15*/ { 0x00088bb0U, 1, 0xbcc10015U, "XVE_BB0"       },
+                    };
+                    NvU32 permitMask = 0;
+                    NvU32 pi;
+
+                    (void)osReadRegistryDword(pGpu, "CmpXvePermit", &permitMask);
+
+                    if (permitMask != 0)
+                    {
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: XVE_PERMIT begin mask=0x%08x "
+                                  "CAP=0x%08x CAP2=0x%08x\n",
+                                  permitMask,
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                        for (pi = 0; pi < (NvU32)(sizeof(permits) / sizeof(permits[0])); pi++)
+                        {
+                            NvU32 k, fl;
+                            NvU32 pre0, post0, post1;
+
+                            if ((permitMask & (1U << pi)) == 0)
+                                continue;
+
+                            pre0 = GPU_REG_RD32(pGpu, permits[pi].addr);
