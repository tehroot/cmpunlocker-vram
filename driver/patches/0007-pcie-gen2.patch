+                    NvU32 xpSlot = 3, xpOvr = 0xFFFFFFFFU, xpVal = 0x00200000U;
+
+                    (void)osReadRegistryDword(pGpu, "CmpXp3g",     &xp3g);
+                    (void)osReadRegistryDword(pGpu, "CmpXp3gSlot", &xpSlot);
+                    (void)osReadRegistryDword(pGpu, "CmpXp3gOvr",  &xpOvr);
+                    (void)osReadRegistryDword(pGpu, "CmpXp3gVal",  &xpVal);
