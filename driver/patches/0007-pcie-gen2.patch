+                            want2 = 0x00000002U | pubVals[pi];
+
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: PUBSWEEP v=0x%02x rb=0x%08x "
+                                      "CAP=0x%08x CAP2=0x%08x model=0x%08x "
+                                      "dropped=0x%08x\n",
