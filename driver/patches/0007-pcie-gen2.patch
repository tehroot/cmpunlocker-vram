+                NvU32 xi, xattempt;
+                NV_STATUS xpStatus;
+                const NvU32 xp3gCount = sizeof(xp3gTable) / sizeof(xp3gTable[0]);
+                #define PCIE_GEN2_PRIV_MISC_1_ADDR     0x0008841cU
