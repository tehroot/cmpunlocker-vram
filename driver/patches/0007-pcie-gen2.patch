+                                  "SEC2_DEBUG: PUBSWEEP end CAP=0x%08x CAP2=0x%08x\n",
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                    }
+                }
+                /* ===== END GEN3_PUBSWEEP ===== */
+
+                GPU_REG_WR32(pGpu, 0x0008872cU, xveCmd);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN_EARLY after XVE  want=0x%08x XVE=0x%08x "
+                          "CAP=0x%08x CAP2=0x%08x\n",
