+
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: XVE_PERMIT b%u %s(0x%06x x%u) "
+                                      "pre=0x%08x want=0x%08x post=0x%08x "
+                                      "post2=0x%08x %s "
+                                      "CAP=0x%08x CAP2=0x%08x\n",
+                                      pi, permits[pi].name, permits[pi].addr,
+                                      permits[pi].count, pre0, permits[pi].value,
+                                      post0, post1,
+                                      (post1 == permits[pi].value) ? "STUCK" : "REVERTED",
+                                      GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                      GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                        }
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: XVE_PERMIT end CAP=0x%08x CAP2=0x%08x\n",
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                    }
+                }
+                /* ===== END XVE_PERMIT ===== */
+
+                /* ===== BEGIN XP3G_OVR =====
+                 * Override the fuse-derived XP3G status word.
+                 *
+                 * XP3G is a 4-slot override file:
+                 *   STATUS  0x8e100 + 4i   (fuse-driven)
+                 *   OVR     0x8e110 + 4i   (which bits software supplies)
+                 *   VAL     0x8e120 + 4i   (the bits it supplies)
+                 *   PLM     0x8e1b0..1bc   reads 0xffffffff -- already open
+                 *
+                 * On this card STATUS3 (0x8e10c) reads 0x16680000, which is
+                 * exactly the fuse at 0x820520 ("OPT_MAGIC"). So the status word
+                 * is a mirror of that fuse, and OVR/VAL exist to override it.
+                 *
+                 * The A100 reference reads 0x00200000 at 0x820520 (docs/19), so:
+                 *
+                 *   170HX 0x16680000
+                 *   A100  0x00200000
+                 *   XOR   0x16480000   bits 19, 22, 25, 26, 28
+                 *
+                 * 0007 already sets VAL3 = 0x00200000 -- the A100 value -- but
+                 * OVR3 = 0x00000004, so only bit 2 is overridden and none of the
