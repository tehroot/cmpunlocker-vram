+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: XP3G_OVR begin slot=%u ovr=0x%08x "
+                                  "val=0x%08x ST=0x%08x OPT_MAGIC=0x%08x "
+                                  "PLM=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                                  xpSlot, xpOvr, xpVal, st0,
+                                  GPU_REG_RD32(pGpu, 0x00820520U),
+                                  GPU_REG_RD32(pGpu, 0x0008e1b0U),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                        /* VAL before OVR, so no window with a live mask over
+                         * stale data. */
+                        GPU_REG_WR32(pGpu, vAddr, xpVal);
+                        GPU_REG_WR32(pGpu, oAddr, xpOvr);
+
+                        for (fl = 0; fl < 32U; fl++)
+                            (void)GPU_REG_RD32(pGpu, 0x00000000U);
+
+                        st1 = GPU_REG_RD32(pGpu, sAddr);
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: XP3G_OVR after OVR=0x%08x VAL=0x%08x "
+                                  "ST=0x%08x->0x%08x %s CAP=0x%08x CAP2=0x%08x\n",
+                                  GPU_REG_RD32(pGpu, oAddr),
+                                  GPU_REG_RD32(pGpu, vAddr),
+                                  st0, st1,
+                                  (st1 != st0) ? "STATUS MOVED" : "status unchanged",
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
