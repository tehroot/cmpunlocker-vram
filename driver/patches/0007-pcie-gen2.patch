+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN_EARLY after CFG0 CFG0=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                          GPU_REG_RD32(pGpu, 0x0008c040U),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                GPU_REG_WR32(pGpu, PCIE_GEN2_PL_LINK_RATE_ADDR, plVal);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN_EARLY after PL   PL=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_PL_LINK_RATE_ADDR),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                GPU_REG_WR32(pGpu, 0x0008872cU, 0x00000006U);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN_EARLY after XVE  XVE=0x%08x CAP=0x%08x CAP2=0x%08x\n",
