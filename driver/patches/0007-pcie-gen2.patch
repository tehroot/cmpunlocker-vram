+                                  xp3gTable[xi].name);
+                }
+
+                {
+                    NvU32 capNow = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR);
+                    NvU32 cap2Now = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR);
+                    NvU32 opt23Now = GPU_REG_RD32(pGpu, 0x0082057cU);
+                    NvU32 plmXp = GPU_REG_RD32(pGpu, 0x0008e1b0U);
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: PCIe Cap oracle CAP=0x%08x CAP2=0x%08x "
+                              "OPT_GEN23=0x%08x XP3G_PLM=0x%08x\n",
+                              capNow, cap2Now, opt23Now, plmXp);
+                }
+
+                {
+                    NvU32 vsecDevNow = GPU_REG_RD32(pGpu, PCIE_GEN2_VSEC_DEVICE_ADDR);
+                    NvU32 vsecDevWant = vsecDevNow | (1U << 0);
+                    NvBool wrote = NV_FALSE;
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: PCIe VSEC_DEVICE pre=0x%08x want=0x%08x\n",
+                              vsecDevNow, vsecDevWant);
+                    for (xattempt = 0; xattempt < 2 && !wrote; xattempt++)
+                    {
+                        GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                        GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+                        xpStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                            PCIE_GEN2_VSEC_DEVICE_ADDR, vsecDevWant);
+                        if (xpStatus != NV_OK)
+                            continue;
+                        xpStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                            memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+                        NvU32 rd = GPU_REG_RD32(pGpu, PCIE_GEN2_VSEC_DEVICE_ADDR);
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PCIe VSEC_DEVICE booter attempt=%u "
+                                  "status=0x%x rd=0x%08x\n",
+                                  xattempt, xpStatus, rd);
+                        if (rd == vsecDevWant)
+                            wrote = NV_TRUE;
+                    }
+                    if (!wrote)
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PCIe VSEC_DEVICE booter FAILED\n");
+                }
+
+                {
+                    NvU32 misc1 = GPU_REG_RD32(pGpu, PCIE_GEN2_PRIV_MISC_1_ADDR);
+                    NvU32 misc1Want = (misc1 | PCIE_GEN2_PRIV_MISC_1_GEN2_EN)
+                                      & ~PCIE_GEN2_PRIV_MISC_1_GEN2_VAL;
+                    NvBool wrote = NV_FALSE;
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: PCIe PRIV_MISC_1 pre=0x%08x want=0x%08x\n",
+                              misc1, misc1Want);
+                    for (xattempt = 0; xattempt < 2 && !wrote; xattempt++)
+                    {
+                        GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                        GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+                        xpStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                            PCIE_GEN2_PRIV_MISC_1_ADDR, misc1Want);
+                        if (xpStatus != NV_OK)
+                            continue;
+                        xpStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                            memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+                        NvU32 rd = GPU_REG_RD32(pGpu, PCIE_GEN2_PRIV_MISC_1_ADDR);
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PCIe PRIV_MISC_1 booter attempt=%u "
+                                  "status=0x%x rd=0x%08x\n",
+                                  xattempt, xpStatus, rd);
+                        if (rd == misc1Want)
+                            wrote = NV_TRUE;
+                    }
+                    if (!wrote)
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PCIe PRIV_MISC_1 booter FAILED\n");
+                }
+
+                /*
+                 * Fuse-OPT override, via the same Booter arbitrary-write
+                 * primitive. Runs here so it lands BEFORE the GEN_EARLY block
+                 * pokes 0x8872c, which is the cap-publish trigger.
+                 *
+                 * Standing question from doc 07 Q1 / doc 09: the beta wrote
+                 * OPT_GEN23 and it was rejected, but EN_SW_OVERRIDE (0x820040)
+                 * was never set first, so OPT writes were being discarded by a
+                 * gate that had never been opened. Untested since.
+                 *
+                 * Motivation now: with MAX_RATE=3 the publish still emits
+                 * CAP=0x00456102 / CAP2=0x6, so a Gen2 clamp sits between the
+                 * XP ceiling and LnkCap. OPT_GEN3 feeding that clamp is the
+                 * remaining reachable hypothesis.
+                 *
+                 * CmpFuseOvr = value written to EN_SW_OVERRIDE, 0 = disabled.
+                 * The encoding of 0x820040 is not in any header available here,
+                 * so try 1 and 0xffffffff.
+                 *
+                 * Readback distinguishes the outcomes: OPT_GEN3 reading 0x0
+                 * means the shadow is writable once the gate is open and any
+                 * remaining clamp is elsewhere; still 0x1 means hard-RO even
+                 * with the override enabled.
+                 */
+                {
+                    NvU32 fuseOvr = 0;
+
+                    (void)osReadRegistryDword(pGpu, "CmpFuseOvr", &fuseOvr);
+                    if (fuseOvr != 0)
+                    {
+                        struct { NvU32 addr; NvU32 value; const char *name; } fuseSeq[4];
+                        NvU32 fi, fuseCnt = 0, fuseGen = 0, fuseTest = 0;
+                        NvU32 nvdecSave = 0;
+
+                        (void)osReadRegistryDword(pGpu, "CmpFuseGen",  &fuseGen);
+                        (void)osReadRegistryDword(pGpu, "CmpFuseTest", &fuseTest);
+
+                        /*
+                         * Sequence is built from the regkeys so the failing gen
+                         * writes are opt-in. Each failed Booter load returns
+                         * 0xffff, and a run with several of them pushed GSP
+                         * bootstrap into a retry loop, so they are no longer
+                         * unconditional.
+                         *
+                         * 0x880040 was dropped: doc 07:60's "redundant copy at
+                         * +0x60000" reads 0xbadf1100 (priv-poisoned), so it is
+                         * not a writable mirror at that offset.
+                         *
+                         * CmpFuseTest is the control. ga100/dev_fuse.h publishes
+                         * NV_FUSE_OPT_NVDEC_DISABLE 0x00820378 DATA 4:0 RWIVF --
+                         * an OPT register architecturally RW, on a part with no
+                         * NVDEC workload. If it takes while OPT_GEN3/OPT_GEN23
+                         * reject, the OPT write path is open and the gen fuses
+                         * are specifically protected. If it rejects too, the path
+                         * is globally locked and EN_SW_OVERRIDE is not the gate.
+                         * Toggled and restored in the same pass.
+                         */
+                        fuseSeq[fuseCnt].addr  = 0x00820040U;
+                        fuseSeq[fuseCnt].value = fuseOvr;
+                        fuseSeq[fuseCnt].name  = "EN_SW_OVERRIDE";
+                        fuseCnt++;
+
+                        if (fuseTest != 0)
+                        {
+                            nvdecSave = GPU_REG_RD32(pGpu, 0x00820378U);
+                            fuseSeq[fuseCnt].addr  = 0x00820378U;
+                            fuseSeq[fuseCnt].value = (nvdecSave ^ 0x00000001U) & 0x0000001FU;
+                            fuseSeq[fuseCnt].name  = "CTRL_OPT_NVDEC_DIS";
+                            fuseCnt++;
+                        }
+
+                        if (fuseGen != 0)
+                        {
+                            fuseSeq[fuseCnt].addr  = 0x00820580U;
+                            fuseSeq[fuseCnt].value = 0x00000000U;
+                            fuseSeq[fuseCnt].name  = "OPT_GEN3";
+                            fuseCnt++;
+                            fuseSeq[fuseCnt].addr  = 0x0082057cU;
+                            fuseSeq[fuseCnt].value = 0x00000000U;
+                            fuseSeq[fuseCnt].name  = "OPT_GEN23";
+                            fuseCnt++;
+                        }
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: FUSE_OVR begin ovr=0x%08x gen=%u test=%u EN=0x%08x "
+                                  "GEN3=0x%08x GEN23=0x%08x NVDEC=0x%08x\n",
+                                  fuseOvr, fuseGen, fuseTest,
+                                  GPU_REG_RD32(pGpu, 0x00820040U),
+                                  GPU_REG_RD32(pGpu, 0x00820580U),
+                                  GPU_REG_RD32(pGpu, 0x0082057cU),
+                                  GPU_REG_RD32(pGpu, 0x00820378U));
+
+                        for (fi = 0; fi < fuseCnt; fi++)
+                        {
+                            NvBool fwrote = NV_FALSE;
+
+                            for (xattempt = 0; xattempt < 2 && !fwrote; xattempt++)
+                            {
+                                NvU32 frd;
+
+                                GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                                GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+
+                                xpStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                                    fuseSeq[fi].addr, fuseSeq[fi].value);
+                                if (xpStatus != NV_OK)
+                                    continue;
+
+                                xpStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                                    memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+
+                                frd = GPU_REG_RD32(pGpu, fuseSeq[fi].addr);
+                                NV_PRINTF(LEVEL_ERROR,
+                                          "SEC2_DEBUG: FUSE_OVR %s(0x%06x)=0x%08x attempt=%u "
+                                          "status=0x%x rd=0x%08x\n",
+                                          fuseSeq[fi].name, fuseSeq[fi].addr,
+                                          fuseSeq[fi].value, xattempt, xpStatus, frd);
+                                if (frd == fuseSeq[fi].value)
+                                    fwrote = NV_TRUE;
+                            }
+                            if (!fwrote)
+                                NV_PRINTF(LEVEL_ERROR,
+                                          "SEC2_DEBUG: FUSE_OVR FAILED to set %s\n",
+                                          fuseSeq[fi].name);
+                        }
+
+                        if (fuseTest != 0)
+                        {
+                            GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                            GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+                            (void)kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                                0x00820378U, nvdecSave);
+                            (void)kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                                memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: FUSE_OVR NVDEC restore want=0x%08x rd=0x%08x\n",
+                                      nvdecSave, GPU_REG_RD32(pGpu, 0x00820378U));
+                        }
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: FUSE_OVR end EN=0x%08x GEN3=0x%08x GEN23=0x%08x "
+                                  "NVDEC=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                                  GPU_REG_RD32(pGpu, 0x00820040U),
+                                  GPU_REG_RD32(pGpu, 0x00820580U),
+                                  GPU_REG_RD32(pGpu, 0x0082057cU),
+                                  GPU_REG_RD32(pGpu, 0x00820378U),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                    }
+                }
+
+                /*
+                 * PLM sweep for the 0x85xxx block.
+                 *
+                 * 0x85080 / 0x85084 are the allowed-mask RM re-derives the link
+                 * cap from, and they read 0xbadf1100 in every context tried --
+                 * driver GPU_REG_RD32 and the SEC2-postbl ROP. Unlike every
+                 * other block we touch, 0001's PLM table has no entry covering
+                 * 0x85xxx, so that gate has never actually been opened.
+                 *
+                 * Candidate addresses come from the naming convention visible
+                 * in the ZB fuse headers, NV_FUSE_ZB_OPT_*__PRIV_LEVEL_MASK
+                 * = 0x000000FC, i.e. PLM at block base + 0xFC. That is exactly
+                 * how OPT_PLM lands at 0x8200fc, which 0001 opens successfully
+                 * (reads 0xffffffff on-card). So 0x850fc is the first guess.
+                 *
+                 * CmpPlm = address to open, CmpPlmCnt = consecutive dwords
+                 * (default 1, capped at 4 -- each is a Booter load, and a run
+                 * with several failing loads pushed GSP bootstrap into a retry
+                 * loop). Logs 0x85080/0x85084 before and after so a lifted
+                 * poison is immediately visible.
+                 */
+                {
+                    NvU32 plmAddr = 0, plmCnt = 1, pi;
+
+                    (void)osReadRegistryDword(pGpu, "CmpPlm", &plmAddr);
+                    (void)osReadRegistryDword(pGpu, "CmpPlmCnt", &plmCnt);
+                    if (plmCnt == 0)
+                        plmCnt = 1;
+                    if (plmCnt > 4)
+                        plmCnt = 4;
+
+                    if (plmAddr != 0)
+                    {
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PLM_SWEEP begin addr=0x%06x cnt=%u "
+                                  "s80=0x%08x s84=0x%08x\n",
+                                  plmAddr, plmCnt,
+                                  GPU_REG_RD32(pGpu, 0x00085080U),
+                                  GPU_REG_RD32(pGpu, 0x00085084U));
+
+                        for (pi = 0; pi < plmCnt; pi++)
+                        {
+                            NvU32 pAddr = plmAddr + (pi * 4U);
+                            NvU32 pRd;
+
+                            GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                            GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+
+                            xpStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                                pAddr, 0xffffffffU);
+                            if (xpStatus != NV_OK)
+                                continue;
+
+                            xpStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                                memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+
+                            pRd = GPU_REG_RD32(pGpu, pAddr);
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: PLM_SWEEP 0x%06x status=0x%x rd=0x%08x "
+                                      "s80=0x%08x s84=0x%08x\n",
+                                      pAddr, xpStatus, pRd,
+                                      GPU_REG_RD32(pGpu, 0x00085080U),
+                                      GPU_REG_RD32(pGpu, 0x00085084U));
+                        }
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PLM_SWEEP end s80=0x%08x s84=0x%08x "
+                                  "CAP=0x%08x CAP2=0x%08x\n",
+                                  GPU_REG_RD32(pGpu, 0x00085080U),
+                                  GPU_REG_RD32(pGpu, 0x00085084U),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                    }
+                }
+
+                /*
+                 * Feature-override shadow write, via the Booter primitive.
+                 *
+                 * The FEAT_DUMP established the live window as 0x823800..
+                 * 0x82382c (0x823830 and up read badf5040, unpopulated):
+                 *   0x823800 ffffffff  FUSE_FEATURE_OVERRIDE PLM (opened)
+                 *   0x823804 ffffffff  FEAT PLM (opened)
+                 *   0x823808 00000281
+                 *   0x82380c 00888888  nibble-per-pipe
+                 *   0x823810 002aaaaa  nibble-per-pipe, looks like fused rate
+                 *   0x823814 00000233  NV_FUSE_FEATURE_READOUT (published, RO)
+                 *   0x823818 00000000
+                 *   0x82381c 88888888  SS0, the compute override
+                 *   0x823820 00000008  SS1
+                 *   0x823824 00000001  <- lone set bit, same value as OPT_GEN3
+                 *   0x823828 00000000
+                 *   0x82382c 0000000a
+                 *
+                 * Pry 2.1 puts "a PCIe boot-speed (Gen3-disable) bit" in this
+                 * block alongside SM rate and FB geometry; 6.2 accounts for the
+                 * nibble-patterned registers as per-pipe rate codes. That
+                 * leaves 0x823808, 0x823824 and 0x82382c unaccounted, and
+                 * 0x823824 has the shape of a disable bit.
+                 *
+                 * Runs before GEN_EARLY so any change is picked up by the
+                 * 0x8872c publish. Readback plus CAP/CAP2 logged.
+                 *
+                 *   CmpFeatAddr  register to write (0 = disabled)
+                 *   CmpFeatVal   value to write (default 0)
+                 */
+                {
+                    NvU32 featAddr = 0, featVal = 0;
+
+                    (void)osReadRegistryDword(pGpu, "CmpFeatAddr", &featAddr);
+                    (void)osReadRegistryDword(pGpu, "CmpFeatVal",  &featVal);
+
+                    if (featAddr != 0)
+                    {
+                        NvBool fowrote = NV_FALSE;
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: FEAT_WR begin addr=0x%06x val=0x%08x cur=0x%08x "
+                                  "CAP=0x%08x CAP2=0x%08x\n",
+                                  featAddr, featVal, GPU_REG_RD32(pGpu, featAddr),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                        for (xattempt = 0; xattempt < 2 && !fowrote; xattempt++)
+                        {
+                            NvU32 frd;
+
+                            GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                            GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+
+                            xpStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                                featAddr, featVal);
+                            if (xpStatus != NV_OK)
+                                continue;
+
+                            xpStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                                memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+
+                            frd = GPU_REG_RD32(pGpu, featAddr);
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: FEAT_WR 0x%06x=0x%08x attempt=%u status=0x%x "
+                                      "rd=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                                      featAddr, featVal, xattempt, xpStatus, frd,
+                                      GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                      GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                            if (frd == featVal)
+                                fowrote = NV_TRUE;
+                        }
+
+                        if (!fowrote)
+                            NV_PRINTF(LEVEL_ERROR, "SEC2_DEBUG: FEAT_WR FAILED\n");
+                    }
+                }
+
+                GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+            }
+
+            {
+                NvU32 hier = GPU_REG_RD32(pGpu, PCIE_GEN2_VSEC_HIERARCHY_ADDR);
+                hier = (hier & ~(1U << 12)) | (1U << 0);
+                GPU_REG_WR32(pGpu, PCIE_GEN2_VSEC_HIERARCHY_ADDR, hier);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: PCIe vsec hierarchy=0x%08x device=0x%08x\n",
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_VSEC_HIERARCHY_ADDR),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_VSEC_DEVICE_ADDR));
+            }
+
+            /* ===== GEN3 PHASE 0/1 PROBE (read-only dump + retrain-free advertise; self-restoring) ===== */
+            {
+                NvU32 g3s80  = GPU_REG_RD32(pGpu, 0x00085080U);
+                NvU32 g3s84  = GPU_REG_RD32(pGpu, 0x00085084U);
+                NvU32 g3cya0 = GPU_REG_RD32(pGpu, 0x0008C2C0U);
+                NvU32 g3cya1 = GPU_REG_RD32(pGpu, 0x0008C300U);
+                NvU32 g3opt3 = GPU_REG_RD32(pGpu, 0x00820580U);
+                NvU32 g3lc0  = GPU_REG_RD32(pGpu, 0x0008C040U);
+                NvU32 g3cap2 = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN3_P0 s80=0x%08x s84=0x%08x CYA0=0x%08x CYA1=0x%08x "
+                          "OPT_GEN3=0x%08x LINK_CFG0=0x%08x CAP2=0x%08x "
+                          "(s80/s84=0xbadf -> driver-ctx walled; CYA0 bit>2 set -> DIS_G3 exists)\n",
+                          g3s80, g3s84, g3cya0, g3cya1, g3opt3, g3lc0, g3cap2);
+            }
+            /* ===== END GEN3 PROBE (read-only: no writes, no retrain) ===== */
+
+            /* ===== SMBPBI MSGBOX REACHABILITY (read-only; see docs/15) =====
+               NV_THERM_MSGBOX_COMMAND = 0x660e0 (nvswitch lr10 dev_therm.h:45 --
+               cross-SKU inference; GA100 dev_therm.h is curated out). DATA/EXT_DATA
+               offsets are unpublished, so dump the adjacent dwords as bisection
+               candidates. Plausible value => mailbox is host-reachable, and Phase 0.5
+               (NULL_CMD then GET_CAP_DWORD) can test whether the PMU services a
+               host-written doorbell. 0xBADF1100 => priv-poisoned from driver context,
+               same class as 0x85080 -- fall back to SMBus (slot pins B5/B6). */
+            {
+                NvU32 mbCmd = GPU_REG_RD32(pGpu, 0x000660E0U);
+                NvU32 mbD1  = GPU_REG_RD32(pGpu, 0x000660E4U);
+                NvU32 mbD2  = GPU_REG_RD32(pGpu, 0x000660E8U);
+                NvU32 mbD3  = GPU_REG_RD32(pGpu, 0x000660ECU);
+                NvU32 mbD4  = GPU_REG_RD32(pGpu, 0x000660F0U);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN3_P0 MSGBOX cmd(0x660e0)=0x%08x "
+                          "e4=0x%08x e8=0x%08x ec=0x%08x f0=0x%08x "
+                          "(0xbadf -> walled; else CMD STATUS=[28:24] INTR=[31]; "
+                          "next: NULL_CMD=0x80000000 GET_CAP_DWORD=0x80000201 "
+                          "PAGE_6_LTSSM=0x80000621)\n",
+                          mbCmd, mbD1, mbD2, mbD3, mbD4);
+            }
+            /* ===== END SMBPBI PROBE (read-only) ===== */
+
+            /*
+             * PHY / gate registers, read-only.
+             *
+             * Falcon external addresses encode the PRI target in the top byte:
+             * falcon = 0x14000000 | pri. Confirmed against this driver's own
+             * constants -- app08 references 0x1408c2c0 (== CYA_0 0x8c2c0),
+             * 0x1408841c (== PRIV_MISC_1), 0x1408c300 (== CYA_1), 0x1408c1c0
+             * (== PL_LINK_RATE), 0x14088088 (== LINK_CTRL_STATUS), 0x14820520
+             * (== OPT_MAGIC), 0x149a0204 (FBPA) -- nine exact matches.
+             *
+             * docs 02/12/13 read 0x14118f78 literally as a BAR0 offset and
+             * concluded it was a reset-latched strap beyond the 16 MB aperture
+             * and unreachable. It is PRI 0x118f78, inside the aperture, and has
+             * never been read.
+             *
+             * app08's gate (docs/17):
+             *   run the PHY routine  <=>  0x11823c[11:10] == 2
+             *                         AND 0x118f78[30]   == 1
+             * and app08 itself clears 0x118f78 bit30 elsewhere.
+             *
+             * CmpFeatAddr / CmpFeatVal can target any of these for a Booter
+             * write once the reads show what is there.
+             */
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PHY_GATE sel(0x11823c)=0x%08x [11:10]=%u  "
+                      "strap(0x118f78)=0x%08x bit30=%u\n",
+                      GPU_REG_RD32(pGpu, 0x0011823cU),
+                      (GPU_REG_RD32(pGpu, 0x0011823cU) >> 10) & 0x3U,
+                      GPU_REG_RD32(pGpu, 0x00118f78U),
+                      (GPU_REG_RD32(pGpu, 0x00118f78U) >> 30) & 0x1U);
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PHY_GATE uphy e80=0x%08x e90=0x%08x bb4=0x%08x "
+                      "b90=0x%08x c50=0x%08x  lane0=0x%08x lane1=0x%08x\n",
+                      GPU_REG_RD32(pGpu, 0x00118e80U),
+                      GPU_REG_RD32(pGpu, 0x00118e90U),
+                      GPU_REG_RD32(pGpu, 0x00118bb4U),
+                      GPU_REG_RD32(pGpu, 0x00118b90U),
+                      GPU_REG_RD32(pGpu, 0x00118c50U),
+                      GPU_REG_RD32(pGpu, 0x00137678U),
+                      GPU_REG_RD32(pGpu, 0x001376f8U));
+            /*
+             * Outer selector and execution witnesses.
+             *
+             * app08 caller, one level above the gate (docs/17):
+             *     and   $r9 0x1        ; [0x12e0] & 1
+             *     bra e 0x159c         ; == 0 -> predicate, then 0xcb00
+             *     lcall 0x8034         ; != 0 -> different path, gate never reached
+             * so 0x12e0[0] decides whether the gate is even consulted.
+             *
+             * Witnesses that 0xcb00 actually executed. Its first act is
+             * e90 = (e90 & ~0x320) | 0x40800, so from 0x00028400 it would
+             * leave 0x00068c00. It also writes the FBPA/UPHY group
+             * 0x9a0090/0094/0154/0210/103c and 0x13744c / 0x137450, none of
+             * which any other path touches. lane0/lane1 above are NOT
+             * witnesses for this -- they belong to sub 0x3c7a on the shared
+             * path.
+             */
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PHY_GATE outer(0x12e0)=0x%08x bit0=%u  "
+                      "e90_expect_if_ran=0x%08x\n",
+                      GPU_REG_RD32(pGpu, 0x000012e0U),
+                      GPU_REG_RD32(pGpu, 0x000012e0U) & 1U,
+                      (GPU_REG_RD32(pGpu, 0x00118e90U) & ~0x320U) | 0x40800U);
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PHY_GATE witness 9a0090=0x%08x 9a0094=0x%08x "
+                      "9a0154=0x%08x 9a103c=0x%08x 13744c=0x%08x 137450=0x%08x\n",
+                      GPU_REG_RD32(pGpu, 0x009a0090U),
+                      GPU_REG_RD32(pGpu, 0x009a0094U),
+                      GPU_REG_RD32(pGpu, 0x009a0154U),
+                      GPU_REG_RD32(pGpu, 0x009a103cU),
+                      GPU_REG_RD32(pGpu, 0x0013744cU),
+                      GPU_REG_RD32(pGpu, 0x00137450U));
+            /* ===== END PHY_GATE PROBE (read-only) ===== */
+
+            /*
+             * Lane-map register group.
+             *
+             * app08 IMEM 0x2509..0x25d1 loads bytes from DMEM 0x40..0x4a, packs
+             * them four per dword and writes 0x14132a04 / 0x14132a08 /
+             * 0x14132a10 -- i.e. PRI 0x132a04 / 0x132a08 / 0x132a10 under the
+             * mapping in docs/18.
+             *
+             * That DMEM table is the one place a SKU difference survives the
+             * three-way ROM control (docs/17). 0x1f reads as a disabled entry:
+             *
+             *   A100 20b0 / 20bb :  00 01 02 03 04 05 06 07 08  1f 02 01
+             *   170HX 20c2       :  1f 01 02 1f 1f 1f 1f 1f 1f  1f 02 01
+             *
+             * Nine populated entries on the uncrippled parts, two here. Both
+             * builds reference 0x132a04, so the code is common and only the data
+             * differs. Read the whole group to see what actually landed.
+             */
+            {
+                NvU32 la;
+                for (la = 0x00132a00U; la < 0x00132a30U; la += 0x10U)
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: LANEMAP 0x%06x: %08x %08x %08x %08x\n",
+                              la,
+                              GPU_REG_RD32(pGpu, la),
+                              GPU_REG_RD32(pGpu, la + 0x4U),
+                              GPU_REG_RD32(pGpu, la + 0x8U),
+                              GPU_REG_RD32(pGpu, la + 0xcU));
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: LANEMAP neighbours 1321a4=%08x 1321b0=%08x "
+                          "132af4=%08x 132b00=%08x 132518=%08x 132844=%08x\n",
+                          GPU_REG_RD32(pGpu, 0x001321a4U),
+                          GPU_REG_RD32(pGpu, 0x001321b0U),
+                          GPU_REG_RD32(pGpu, 0x00132af4U),
+                          GPU_REG_RD32(pGpu, 0x00132b00U),
+                          GPU_REG_RD32(pGpu, 0x00132518U),
+                          GPU_REG_RD32(pGpu, 0x00132844U));
+            }
+            /* ===== END LANEMAP PROBE (read-only) ===== */
+
+            /*
+             * 0x118f78 field sweep.
+             *
+             * FWSEC_COMPARISON.md records devinit's RMW on this register using
+             * masks 0x3000 / 0x2000 / 0xc000 / 0x8000, "programs the PCIe link
+             * config per the fuse selector" -- i.e. two 2-bit fields, [13:12]
+             * and [15:14], both reading 0 on this card. 0x3000 was tried by
+             * hand and left CAP2 at 0x6.
+             *
+             * The publish trigger 0x8872c is host-writable, so each value can be
+             * written and re-published in the same boot instead of one reboot
+             * per value. Runs here, before GEN_EARLY, while the link is still at
+             * Gen1 and CAP2 is still 0x2.
+             *
+             * Plain GPU_REG_WR32 -- the earlier successful write to this
+             * register used the Booter, so the readback also tells us whether
+             * PL0 writes stick here.
+             *
+             * Restores 0x118f78 to its entry value at the end. CmpSweep=1.
+             */
+            {
+                NvU32 doSweep = 0;
+
+                (void)osReadRegistryDword(pGpu, "CmpSweep", &doSweep);
+                if (doSweep != 0)
+                {
+                    static const NvU32 sweepVals[] = {
+                        0x00001000U, 0x00002000U, 0x00003000U, 0x00004000U,
+                        0x00008000U, 0x0000c000U, 0x0000f000U,
+                        0x40000000U, 0x4000f000U, 0x0000ffffU
+                    };
+                    NvU32 si, saved = GPU_REG_RD32(pGpu, 0x00118f78U);
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: SWEEP begin 0x118f78=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                              saved,
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                    for (si = 0; si < (sizeof(sweepVals)/sizeof(sweepVals[0])); si++)
+                    {
+                        NvU32 rd, cap, cap2;
+
+                        GPU_REG_WR32(pGpu, 0x00118f78U, sweepVals[si]);
+                        rd = GPU_REG_RD32(pGpu, 0x00118f78U);
+                        GPU_REG_WR32(pGpu, 0x0008872cU, 0x00000006U);
+                        (void)GPU_REG_RD32(pGpu, 0x0008872cU);
+                        cap  = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR);
+                        cap2 = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR);
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: SWEEP want=0x%08x rd=0x%08x CAP=0x%08x CAP2=0x%08x%s\n",
+                                  sweepVals[si], rd, cap, cap2,
+                                  ((cap2 & 0x8U) != 0U) ? "   <<< GEN3 BIT SET" : "");
+                    }
+
+                    GPU_REG_WR32(pGpu, 0x00118f78U, saved);
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: SWEEP end 0x118f78=0x%08x CAP2=0x%08x\n",
+                              GPU_REG_RD32(pGpu, 0x00118f78U),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                }
+            }
+            /* ===== END SWEEP ===== */
+
+            /*
+             * Publish-path diff.
+             *
+             * Every register we guessed at leaves CAP2 = 0x6: MAX_RATE,
+             * PL_LINK_RATE, LnkCtl2, CYA_0/1, PRIV_MISC_1, RM policy keys, the
+             * OPT shadows, the feature-override block, and now every field of
+             * 0x118f78. LnkCap/LnkCap2 are RO in the PCFG write map, so the
+             * published value is produced by logic reading something else.
+             *
+             * Rather than guess further: snapshot a 4 KB block, poke the publish
+             * trigger 0x8872c, snapshot again, and report every dword that
+             * moved. Whatever changes alongside CAP (0x88084) and CAP2
+             * (0x880a4) is in the publish path.
+             *
+             * Runs before GEN_EARLY, link still Gen1, CAP2 still 0x2, so the
+             * 0x2 -> 0x6 transition happens inside the diff window.
+             *
+             *   CmpDiff      1 = enable
+             *   CmpDiffBase  block base, default 0x88000 (PCFG). 0x8c000 is the
+             *                XP block; 0x118000 is PGC6.
+             */
+            {
+                static NvU32 diffPre[1024];
+                NvU32 doDiff = 0, diffBase = 0x00088000U, di, changed = 0;
+
+                (void)osReadRegistryDword(pGpu, "CmpDiff", &doDiff);
+                (void)osReadRegistryDword(pGpu, "CmpDiffBase", &diffBase);
+                if (diffBase == 0)
+                    diffBase = 0x00088000U;
+
+                if (doDiff != 0)
+                {
+                    for (di = 0; di < 1024; di++)
+                        diffPre[di] = GPU_REG_RD32(pGpu, diffBase + (di * 4U));
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: DIFF base=0x%06x snapshot taken, CAP=0x%08x CAP2=0x%08x\n",
+                              diffBase,
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                    GPU_REG_WR32(pGpu, 0x0008872cU, 0x00000006U);
+                    (void)GPU_REG_RD32(pGpu, 0x0008872cU);
+
+                    for (di = 0; di < 1024; di++)
+                    {
+                        NvU32 post = GPU_REG_RD32(pGpu, diffBase + (di * 4U));
+                        if (post != diffPre[di])
+                        {
+                            changed++;
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: DIFF 0x%06x: 0x%08x -> 0x%08x\n",
+                                      diffBase + (di * 4U), diffPre[di], post);
+                        }
+                    }
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: DIFF done changed=%u CAP=0x%08x CAP2=0x%08x\n",
+                              changed,
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                }
+            }
+            /* ===== END DIFF ===== */
+
+            /* ===== BEGIN RAW_BOOTER =====
+             * Execute a Booter load using the dmem.bin payload verbatim.
+             *
+             * Why this is needed: dmem.bin is loaded once, in
+             * _kgspCreateSignatureMemdesc(). But the PLM-opening loop in
+             * 0001 runs on every boot and calls
+             * kgspSec2PostblTimingRefillPayload() nine times, and refill calls
+             * _kgspSec2PostblTimingFillPayload() -- which regenerates the
+             * BUILT-IN payload. So by the time any probe runs, the file's
+             * contents are long gone. Every Cmp* path has the same problem:
+             * all 7 refill call sites discard the file.
+             *
+             * That made dmem.bin unusable for chain work despite the load path
+             * existing. This block re-reads the file into the signature buffer
+             * and executes the Booter load WITHOUT refill, so the bytes that
+             * run are exactly the bytes on disk.
+             *
+             * Generate payloads with recon/mkdmem.py (run --verify first; a
+             * generator that has drifted from 0001 makes every result here
+             * meaningless).
+             *
+             * The stock chain performs one PRI write, with writeValue at
+             * 0xf754 and writeAddr at 0xf76c. FILL_DWORD (0x4a7) is a code
+             * address, so unplaced slots are a sled rather than padding --
+             * see docs/20-hs-execution-surface.md.
+             *
+             *   CmpRawBooter  number of Booter loads to run (0 = off, max 8)
+             */
+            {
+                NvU32 rawBooter = 0;
+
+                (void)osReadRegistryDword(pGpu, "CmpRawBooter", &rawBooter);
+
+                if (rawBooter != 0 && pKernelGsp->pSignatureMemdesc != NULL)
+                {
+                    NvU32 wLo = GPU_REG_RD32(pGpu, 0x001fa824U);
+                    NvU32 wHi = GPU_REG_RD32(pGpu, 0x001fa828U);
+                    NvU64 sigSz = memdescGetSize(pKernelGsp->pSignatureMemdesc);
+                    NvU32 iter;
+
+                    if (rawBooter > 8U)
+                        rawBooter = 8U;
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: RAW_BOOTER begin n=%u sigSize=%llu "
+                              "wpr2=0x%08x/0x%08x EN=0x%08x GEN23=0x%08x "
+                              "GEN3=0x%08x CAP2=0x%08x\n",
+                              rawBooter, (unsigned long long)sigSz, wLo, wHi,
+                              GPU_REG_RD32(pGpu, 0x00820040U),
+                              GPU_REG_RD32(pGpu, 0x0082057cU),
+                              GPU_REG_RD32(pGpu, 0x00820580U),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                    for (iter = 0; iter < rawBooter; iter++)
+                    {
+                        NvU8 *pVa;
+                        NV_STATUS fileStatus = NV_ERR_GENERIC;
+                        NV_STATUS bootStatus;
+                        NvU32 head = 0, tail = 0;
+
+                        pVa = memdescMapInternal(pGpu,
+                                  pKernelGsp->pSignatureMemdesc,
+                                  TRANSFER_FLAGS_NONE);
+                        if (pVa != NULL)
+                        {
+                            fileStatus = os_open_and_read_file(
+                                SEC2_POSTBL_TIMING_DMEM_PATH, pVa, sigSz);
+                            if (fileStatus == NV_OK)
+                            {
+                                /* witness the payload actually in the buffer */
+                                head = ((NvU32)pVa[0xf754]) |
+                                       ((NvU32)pVa[0xf755] << 8) |
+                                       ((NvU32)pVa[0xf756] << 16) |
+                                       ((NvU32)pVa[0xf757] << 24);
+                                tail = ((NvU32)pVa[0xf76c]) |
+                                       ((NvU32)pVa[0xf76d] << 8) |
+                                       ((NvU32)pVa[0xf76e] << 16) |
+                                       ((NvU32)pVa[0xf76f] << 24);
+                            }
+                            memdescUnmapInternal(pGpu,
+                                pKernelGsp->pSignatureMemdesc, 0);
+                            memdescFlushCpuCaches(pGpu,
+                                pKernelGsp->pSignatureMemdesc);
+                        }
+
+                        if (fileStatus != NV_OK)
+                        {
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: RAW_BOOTER no payload (0x%x) "
+                                      "-- put one at %s\n",
+                                      fileStatus, SEC2_POSTBL_TIMING_DMEM_PATH);
+                            break;
+                        }
+
+                        if (pKernelGsp->pWprMeta != NULL)
+                        {
+                            pKernelGsp->pWprMeta->sysmemAddrOfSignature =
+                                memdescGetPhysAddr(
+                                    pKernelGsp->pSignatureMemdesc, AT_GPU, 0);
+                            pKernelGsp->pWprMeta->sizeOfSignature = sigSz;
+                        }
+                        if (pKernelGsp->pWprMetaDescriptor != NULL)
+                            memdescFlushCpuCaches(pGpu,
+                                pKernelGsp->pWprMetaDescriptor);
+
+                        GPU_REG_WR32(pGpu, 0x001fa824U, wLo);
+                        GPU_REG_WR32(pGpu, 0x001fa828U, wHi);
+
+                        bootStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                            memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor,
+                                               AT_GPU, 0));
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: RAW_BOOTER iter=%u status=0x%x "
+                                  "f754=0x%08x f76c=0x%08x EN=0x%08x "
+                                  "GEN23=0x%08x GEN3=0x%08x CAP=0x%08x "
+                                  "CAP2=0x%08x\n",
+                                  iter, bootStatus, head, tail,
+                                  GPU_REG_RD32(pGpu, 0x00820040U),
+                                  GPU_REG_RD32(pGpu, 0x0082057cU),
+                                  GPU_REG_RD32(pGpu, 0x00820580U),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                    }
+
+                    GPU_REG_WR32(pGpu, 0x001fa824U, wLo);
+                    GPU_REG_WR32(pGpu, 0x001fa828U, wHi);
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: RAW_BOOTER end EN=0x%08x GEN23=0x%08x "
+                              "GEN3=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                              GPU_REG_RD32(pGpu, 0x00820040U),
+                              GPU_REG_RD32(pGpu, 0x0082057cU),
+                              GPU_REG_RD32(pGpu, 0x00820580U),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                }
+            }
+            /* ===== END RAW_BOOTER ===== */
+
+            /* ===== BEGIN FUSE_MACRO =====
+             * Drive the fuse macro register file directly.
+             *
+             * Established on-card (docs/19):
+             *   - OPT_* (0x8201xx-0x8207xx) refuse writes; they are readouts.
+             *   - STATUS_OPT_* (0x820Cxx) is RO by architecture (t234 header
+             *     names NV_FUSE_STATUS_OPT_DISPLAY 0x00820C04 as R-I4R).
+             *   - EN_SW_OVERRIDE (0x820040) IS writable and persists across a
+             *     module reload -- but setting it does not make OPT_* writable.
+             *   - FUSEADDR (0x820004) IS writable: FEAT_WR 0x1fb -> 0x1fc took.
+             *
+             * So the macro is live and accepts writes. Layout, matching the
+             * standard NVIDIA fuse-macro register file and identical on the
+             * A100 reference part:
+             *
+             *   0x820000 FUSECTRL   CMD[1:0], STATE[20:16]  (0xe0040000 = idle)
+             *   0x820004 FUSEADDR   row select
+             *   0x820008 FUSERDATA  read data
+             *   0x82000c FUSEWDATA  write data
+             *   0x820010 FUSETIME
+             *
+             * This block issues READ commands only. It never writes FUSEWDATA
+             * and never issues CMD=WRITE -- burning a fuse is irreversible,
+             * needs programming voltage, and is not the goal. The goal is to
+             * map which row/bit carries OPT_GEN23 / OPT_GEN3.
+             *
+             * First it probes whether the macro takes a plain GPU_REG_WR32. If
+             * it does, rows can be swept in a loop instead of costing a Booter
+             * load per write, which is what makes a full array dump practical.
+             *
+             * Observed on-card: FUSEADDR bit0 is ignored -- addr and addr+1
+             * return the same word, so the effective row is addr >> 1 and the
+             * sweep steps by 2. Reads complete immediately (spin=2, CTRL back
+             * at idle).
+             *
+             * Also observed: the sweep itself succeeds, but GSP bootstrap fails
+             * afterwards and the card drops off the bus until a cold power
+             * cycle. So each run costs one power cycle regardless of how many
+             * rows it covers -- sweep the whole array in one go rather than
+             * probing incrementally.
+             *
+             *   CmpFuseRd    1 = enable
+             *   CmpFuseRow   first address, default 0
+             *   CmpFuseCnt   address count, default 16 (capped at 2048)
+             */
+            {
+                NvU32 fuseRd = 0, fuseRow = 0, fuseCnt = 16;
+
+                (void)osReadRegistryDword(pGpu, "CmpFuseRd",  &fuseRd);
+                (void)osReadRegistryDword(pGpu, "CmpFuseRow", &fuseRow);
+                (void)osReadRegistryDword(pGpu, "CmpFuseCnt", &fuseCnt);
+
+                if (fuseRd != 0)
+                {
+                    NvU32 savedAddr = GPU_REG_RD32(pGpu, 0x00820004U);
+                    NvU32 ctrl0     = GPU_REG_RD32(pGpu, 0x00820000U);
+                    NvU32 probe;
+                    NvU32 hostWr;
+                    NvU32 r;
+
+                    if (fuseCnt == 0 || fuseCnt > 2048U)
+                        fuseCnt = 16U;
+
+                    /* Is the macro writable without the SEC2 primitive? */
+                    GPU_REG_WR32(pGpu, 0x00820004U, savedAddr ^ 0x1U);
+                    probe  = GPU_REG_RD32(pGpu, 0x00820004U);
+                    hostWr = (probe == (savedAddr ^ 0x1U)) ? 1U : 0U;
+                    GPU_REG_WR32(pGpu, 0x00820004U, savedAddr);
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FUSE_MACRO begin hostwr=%u CTRL=0x%08x "
+                              "ADDR=0x%08x RDATA=0x%08x WDATA=0x%08x EN=0x%08x\n",
+                              hostWr, ctrl0, savedAddr,
+                              GPU_REG_RD32(pGpu, 0x00820008U),
+                              GPU_REG_RD32(pGpu, 0x0082000cU),
+                              GPU_REG_RD32(pGpu, 0x00820040U));
+
+                    if (hostWr != 0)
+                    {
+                        for (r = fuseRow; r < fuseRow + fuseCnt; r += 2U)
+                        {
+                            NvU32 spin;
+                            NvU32 st = 0;
+                            NvU32 rdata;
+
+                            GPU_REG_WR32(pGpu, 0x00820004U, r);
+                            GPU_REG_WR32(pGpu, 0x00820000U,
+                                         (ctrl0 & ~0x00000003U) | 0x00000001U);
+
+                            /* Bounded poll for STATE[20:16] back to idle (4). */
+                            for (spin = 0; spin < 10000U; spin++)
+                            {
+                                st = GPU_REG_RD32(pGpu, 0x00820000U);
+                                if (((st >> 16) & 0x1FU) == 0x4U &&
+                                    (st & 0x3U) == 0U)
+                                    break;
+                            }
+
+                            rdata = GPU_REG_RD32(pGpu, 0x00820008U);
+
+                            NV_PRINTF(LEVEL_ERROR,
+                                      "SEC2_DEBUG: FUSE_MACRO row=0x%03x CTRL=0x%08x "
+                                      "spin=%u RDATA=0x%08x\n",
+                                      r, st, spin, rdata);
+                        }
+
+                        GPU_REG_WR32(pGpu, 0x00820004U, savedAddr);
+                        GPU_REG_WR32(pGpu, 0x00820000U, ctrl0);
+                    }
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FUSE_MACRO end CTRL=0x%08x ADDR=0x%08x "
+                              "GEN23=0x%08x GEN3=0x%08x\n",
+                              GPU_REG_RD32(pGpu, 0x00820000U),
+                              GPU_REG_RD32(pGpu, 0x00820004U),
+                              GPU_REG_RD32(pGpu, 0x0082057cU),
+                              GPU_REG_RD32(pGpu, 0x00820580U));
+                }
+            }
+            /* ===== END FUSE_MACRO ===== */
+
+            /* ===== BEGIN FUSE_SENSE =====
+             * Re-sense the fuse macro with EN_SW_OVERRIDE already set, then test
+             * whether OPT_* became writable.
+             *
+             * Why this is the last register-level option (docs/19): OPT_* and
+             * STATUS_OPT_* are readouts and refuse writes; there is no CTRL_OPT
+             * bank; the fuse array is a perfect 256-row mirror with no repair or
+             * override bank; the publish path never grants bit3; the XP straps
+             * are host-RO. What IS established: EN_SW_OVERRIDE (0x820040) is
+             * writable and persists, and the fuse macro accepts writes and
+             * executes READ commands.
+             *
+             * The hypothesis this tests: OPT_* latched at power-on sense, when
+             * EN_SW_OVERRIDE was still 0, and is RO because the sense already
+             * happened -- not because it is RO in principle. Re-sensing with EN
+             * set is the only mechanism that could re-resolve it.
+             *
+             * SAFETY: CMD=2 is the fuse WRITE (burn) command -- irreversible,
+             * needs programming voltage, and is explicitly refused here. Only
+             * CMD=3 (SENSE_CTRL) is issued. FUSEWDATA is never written.
+             *
+             *   CmpFuseSense  1 = enable
+             *   CmpFuseCmd    command to issue, default 3; 2 is refused
+             */
+            {
+                NvU32 fuseSense = 0, fuseCmd = 3;
+
+                (void)osReadRegistryDword(pGpu, "CmpFuseSense", &fuseSense);
+                (void)osReadRegistryDword(pGpu, "CmpFuseCmd",   &fuseCmd);
+
+                if (fuseSense != 0 && fuseCmd == 2U)
+                {
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FUSE_SENSE REFUSED cmd=2 is the burn "
+                              "command; not issuing\n");
+                }
+                else if (fuseSense != 0)
+                {
+                    NvU32 ctrl0 = GPU_REG_RD32(pGpu, 0x00820000U);
+                    NvU32 spin;
+                    NvU32 st = 0;
+                    NvU32 wr23, wr3;
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FUSE_SENSE begin cmd=%u CTRL=0x%08x "
+                              "EN=0x%08x GEN23=0x%08x GEN3=0x%08x NVDEC=0x%08x "
+                              "CAP=0x%08x CAP2=0x%08x\n",
+                              fuseCmd, ctrl0,
+                              GPU_REG_RD32(pGpu, 0x00820040U),
+                              GPU_REG_RD32(pGpu, 0x0082057cU),
+                              GPU_REG_RD32(pGpu, 0x00820580U),
+                              GPU_REG_RD32(pGpu, 0x00820378U),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                    GPU_REG_WR32(pGpu, 0x00820000U,
+                                 (ctrl0 & ~0x00000003U) | (fuseCmd & 0x3U));
+
+                    for (spin = 0; spin < 100000U; spin++)
+                    {
+                        st = GPU_REG_RD32(pGpu, 0x00820000U);
+                        if (((st >> 16) & 0x1FU) == 0x4U && (st & 0x3U) == 0U)
+                            break;
+                    }
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FUSE_SENSE after CTRL=0x%08x spin=%u "
+                              "EN=0x%08x GEN23=0x%08x GEN3=0x%08x NVDEC=0x%08x "
+                              "CAP=0x%08x CAP2=0x%08x\n",
+                              st, spin,
+                              GPU_REG_RD32(pGpu, 0x00820040U),
+                              GPU_REG_RD32(pGpu, 0x0082057cU),
+                              GPU_REG_RD32(pGpu, 0x00820580U),
+                              GPU_REG_RD32(pGpu, 0x00820378U),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                    /*
+                     * Did the sense make the OPT shadow writable? Plain WR32 --
+                     * if this takes, no Booter load is even needed.
+                     */
+                    GPU_REG_WR32(pGpu, 0x0082057cU, 0x00000000U);
+                    wr23 = GPU_REG_RD32(pGpu, 0x0082057cU);
+                    GPU_REG_WR32(pGpu, 0x00820580U, 0x00000000U);
+                    wr3  = GPU_REG_RD32(pGpu, 0x00820580U);
+
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FUSE_SENSE optwr GEN23=0x%08x %s "
+                              "GEN3=0x%08x %s CAP=0x%08x CAP2=0x%08x\n",
+                              wr23, (wr23 == 0) ? "TOOK" : "refused",
+                              wr3,  (wr3  == 0) ? "TOOK" : "refused",
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                              GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                    GPU_REG_WR32(pGpu, 0x00820000U, ctrl0);
+                }
+            }
+            /* ===== END FUSE_SENSE ===== */
+
+
+            /*
+             * Feature-override shadow block dump (read-only).
+             *
+             * Pry, "A Canary in the Crypto Mine" 2.1: "For each commercial axis
+             * there is a corresponding feature-override shadow register: a
+             * writable register that, when its priv-level mask permits,
+             * overrides the fused cap. SM math rate, framebuffer geometry and
+             * strap selection, and a PCIe boot-speed (Gen3-disable) bit are all
+             * expressed this way."
+             *
+             * This is the block cmpunlocker already uses for compute --
+             * SS0 0x82381c, SS1 0x823820, FEAT PLM 0x823804, FEAT2 0x823b00,
+             * FUSE_FEATURE_OVERRIDE 0x823800 -- and it is the one address range
+             * this project has never swept. Every prior sweep was XVE 0x88xxx,
+             * XP 0x8Cxxx or fuse-OPT 0x820xxx.
+             *
+             * Same paper 6.4 / Table 1 reports Gen3 as not defeated: "no
+             * override field found; PHY calibration appears fuse-gated", with
+             * the explicit caveat that this describes the limit of that effort
+             * rather than a proven wall.
+             *
+             * Runs after the PLM table, so FEAT (0x823804) and FEAT2
+             * (0x823b00) are already open and these should read real values
+             * rather than 0xbadf1100. All-zero rows are skipped to keep the log
+             * readable. Read-only.
+             *
+             *   CmpFeatDump  1 = enable
+             *   CmpFeatBase  window base, default 0x823800, 0x400 bytes dumped
+             */
+            {
+                NvU32 featDump = 0, featBase = 0x00823800U, fa;
+
+                (void)osReadRegistryDword(pGpu, "CmpFeatDump", &featDump);
+                (void)osReadRegistryDword(pGpu, "CmpFeatBase", &featBase);
+                if (featBase == 0)
+                    featBase = 0x00823800U;
+
+                if (featDump != 0)
+                {
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: FEAT_DUMP base=0x%06x len=0x400 "
+                              "(SS0=0x%08x SS1=0x%08x FEAT_PLM=0x%08x FEAT2=0x%08x)\n",
+                              featBase,
+                              GPU_REG_RD32(pGpu, 0x0082381cU),
+                              GPU_REG_RD32(pGpu, 0x00823820U),
+                              GPU_REG_RD32(pGpu, 0x00823804U),
+                              GPU_REG_RD32(pGpu, 0x00823b00U));
+
+                    for (fa = featBase; fa < (featBase + 0x400U); fa += 0x10U)
+                    {
+                        NvU32 v0 = GPU_REG_RD32(pGpu, fa);
+                        NvU32 v1 = GPU_REG_RD32(pGpu, fa + 0x4U);
+                        NvU32 v2 = GPU_REG_RD32(pGpu, fa + 0x8U);
+                        NvU32 v3 = GPU_REG_RD32(pGpu, fa + 0xcU);
+
+                        if ((v0 | v1 | v2 | v3) == 0U)
+                            continue;
+
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: FEAT_DUMP 0x%06x: %08x %08x %08x %08x\n",
+                                  fa, v0, v1, v2, v3);
+                    }
+                }
+            }
+            /* ===== END FEAT_DUMP (read-only) ===== */
+
+            {
+                NvU32 lc2 = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CTRL_2_ADDR);
+                NvU32 linkCfg;
+                NvU32 cya0;
+                /*
+                 * CmpGen3Early: stage this block for Gen3 instead of Gen2.
+                 * This is the only place LnkCap2 has ever been observed to
+                 * move (0x2 -> 0x6). In the late block both 0x880a4 and
+                 * 0x88084 are RO, and CYA_0/CYA_1/PRIV_MISC_1/RMPcieLinkSpeed
+                 * are all inert on the advertise, so if the cap can be pushed
+                 * to 0xe at all it is from here.
+                 * Default 0 -> unchanged Gen2 behaviour.
+                 */
+                NvU32 early = 0;
+                NvU32 tgt   = PCIE_GEN2_LINK_SPEED;
+                NvU32 rate  = 0x2U;
+                NvU32 plVal = PCIE_GEN2_PL_LINK_RATE_VALUE;
+                /*
+                 * 0x8872c is the supported-speeds source, not an "LTSSM nudge"
+                 * as the beta patch named it. On a clean boot:
+                 *     0x8872c = 0x0 -> LnkCap2 = 0x2   (Gen1 only)
+                 *     0x8872c = 0x6 -> LnkCap2 = 0x6   (Gen1 + Gen2)
+                 * i.e. LnkCap2 = 0x2 | value. LnkCap2[7:1] is the PCIe
+                 * supported-speeds vector, bit1 = 2.5, bit2 = 5.0, bit3 = 8.0,
+                 * so 0xe should advertise Gen3. Every run in this project has
+                 * written the literal 6, inherited from the beta patch.
+                 * LnkCap2 itself is RO in NV_PCFG_XVE_REGISTER_WR_MAP, which is
+                 * consistent with it being published from here.
+                 */
+                NvU32 xveCmd = 0x00000006U;
+
+                (void)osReadRegistryDword(pGpu, "CmpGen3Early", &early);
+                (void)osReadRegistryDword(pGpu, "CmpXveCmd", &xveCmd);
+                if (early != 0)
+                {
+                    tgt   = 0x3U;
+                    rate  = 0x3U;
+                    plVal = 0x00340036U;
+                }
+
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: GEN_EARLY begin early=%u tgt=%u CAP=0x%08x CAP2=0x%08x LC2=0x%08x\n",
+                          early, tgt,
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR),
+                          GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CTRL_2_ADDR));
+                {
+                    /*
+                     * XVE CYA cluster, BAR0 0x88700..0x88740 (cfg 0x700..0x740).
+                     * 17 contiguous dwords, all flagged writable by
+                     * NV_PCFG_XVE_REGISTER_WR_MAP (ga100
+                     * dev_nv_pcfg_xve_regmap.h). Only two are named on any
+                     * published chip: CYA_2 at 0x704 and SW_RESET at 0x718.
+                     * 0x72c -- the cap-publish trigger -- is in this cluster.
+                     * The regmap also confirms LnkCap (0x084) and LnkCap2
+                     * (0x0a4) are RO in the block itself, so the advertise is
+                     * produced upstream of PCFG and this is the nearest
+                     * writable vendor surface to it. Read-only for now.
+                     * NOTE 0x88718 is SW_RESET -- never write this cluster
+                     * blind.
+                     */
+                    NvU32 cyaOff;
+                    for (cyaOff = 0x00088700U; cyaOff <= 0x00088740U; cyaOff += 0x10U)
+                    {
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: XVE_CYA %s 0x%05x: %08x %08x %08x %08x\n",
+                                  "pre ",
+                                  cyaOff,
+                                  GPU_REG_RD32(pGpu, cyaOff),
+                                  (cyaOff + 0x4U <= 0x00088740U) ? GPU_REG_RD32(pGpu, cyaOff + 0x4U) : 0U,
+                                  (cyaOff + 0x8U <= 0x00088740U) ? GPU_REG_RD32(pGpu, cyaOff + 0x8U) : 0U,
+                                  (cyaOff + 0xcU <= 0x00088740U) ? GPU_REG_RD32(pGpu, cyaOff + 0xcU) : 0U);
+                    }
+                }
+
+                /* ===== BEGIN GEN3_STRAP =====
+                 * Force the XP registers that differ from an uncrippled GA100
+                 * to their A100 values, BEFORE LnkCap2 is published at 0x8872c.
+                 *
+                 * Values from docs/19-a100-reference-diff.md: live BAR0 capture
+                 * of an A100-SXM4-80GB (10de:20b2, same boot0=0x170000a1)
+                 * training Gen4 x16, diffed against this card.
+                 *
+                 * Rationale: 0x82057c (OPT_GEN23) and 0x820580 (OPT_GEN3) are 0
+                 * on the A100 and 1 here -- confirmed crippling fuses. No ROM
+                 * references either address, so they are consumed as hardware
+                 * straps, and the straps land here. Every previous Gen3 attempt
+                 * wrote CAP2 while the strap was still set; if the strap gates
+                 * what CAP2 may hold, bit3 writes are dropped. Clearing first is
+                 * the untested step.
+                 *
+                 * ONLY offsets 0007 does not otherwise write are included.
+                 * 0x8c040 and 0x8c1c0 are deliberately absent -- their deltas
+                 * against the A100 are this patch's own Gen2 writes, not the
+                 * crippling.
+                 *
+                 * CmpGen3Strap is a bitmask, one bit per entry, so entries can
+                 * be bisected on-card without a rebuild. 0 (default) = inert.
+                 */
+                {
+                    static const struct
+                    {
+                        NvU32       addr;
+                        NvU32       mask;
+                        NvU32       value;
+                        const char *name;
+                    } straps[] = {
+                        /* bit0 */ { 0x0008c498U, 0xFFFFFFFFU, 0x000F0040U, "XP_498_zeroed"  },
+                        /* bit1 */ { 0x0008c49cU, 0xFFFFFFFFU, 0x0040A855U, "XP_49C_zeroed"  },
+                        /* bit2 */ { 0x0008c4a0U, 0x000007FFU, 0x0000042FU, "XP_4A0_low11"   },
+                        /* bit3 */ { 0x0008c4f0U, 0x00000220U, 0x00000220U, "XP_4F0_b5_b9"   },
+                        /* bit4 */ { 0x0008c2c0U, 0x00802001U, 0x00000000U, "XP_CYA0_b0_13_23" },
+                        /* bit5 */ { 0x0008c080U, 0xFFFFFFFFU, 0x00001010U, "XP_080"         },
+                        /* bit6 */ { 0x0008c140U, 0xFFFFFFFFU, 0xFFFF00FFU, "XP_140"         },
+                    };
+                    NvU32 strapMask = 0;
+                    NvU32 si;
+
+                    (void)osReadRegistryDword(pGpu, "CmpGen3Strap", &strapMask);
+
+                    if (strapMask != 0)
+                    {
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: GEN3_STRAP begin mask=0x%08x "
+                                  "GEN23=0x%08x GEN3=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                                  strapMask,
+                                  GPU_REG_RD32(pGpu, 0x0082057cU),
+                                  GPU_REG_RD32(pGpu, 0x00820580U),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                        for (si = 0; si < (NvU32)(sizeof(straps) / sizeof(straps[0])); si++)
+                        {
+                            NvU32 pre;
+                            NvU32 want;
+                            NvU32 post;
+                            NvU32 post2;
+                            NvU32 fl;
+
+                            if ((strapMask & (1U << si)) == 0)
