+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+                    }
+                }
+                /* ===== END GEN3_STRAP ===== */
+
+                /* ===== BEGIN XVE_PERMIT =====
+                 * Hunt the source of the LnkCap2 "permitted" mask.
+                 *
+                 * Established (docs/19): LnkCap2 = (0x2 | v) & permitted, where
+                 * v is the 4-bit field at 0x8872c and bit3 is never granted --
+                 * across all 11 values swept. The mask is fixed upstream of the
+                 * publish trigger and is not the XP straps (host-RO, and the one
+                 * writable XP reg moved nothing).
