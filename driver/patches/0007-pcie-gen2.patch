+                        0x00000008U, 0x0000000aU, 0x0000000cU, 0x0000000eU,
+                        0x0000000fU, 0x0000001eU, 0x0000003eU,
+                    };
+                    NvU32 pubSweep = 0;
+                    NvU32 pi;
+
+                    (void)osReadRegistryDword(pGpu, "CmpPubSweep", &pubSweep);
+
+                    if (pubSweep != 0)
+                    {
+                        NV_PRINTF(LEVEL_ERROR,
+                                  "SEC2_DEBUG: PUBSWEEP begin XVE=0x%08x CAP=0x%08x CAP2=0x%08x\n",
+                                  GPU_REG_RD32(pGpu, 0x0008872cU),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR),
+                                  GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR));
+
+                        for (pi = 0; pi < (NvU32)(sizeof(pubVals) / sizeof(pubVals[0])); pi++)
+                        {
+                            NvU32 rb;
+                            NvU32 cap;
+                            NvU32 cap2;
+                            NvU32 want2;
+
+                            GPU_REG_WR32(pGpu, 0x0008872cU, pubVals[pi]);
+
+                            rb   = GPU_REG_RD32(pGpu, 0x0008872cU);
+                            cap  = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP_ADDR);
+                            cap2 = GPU_REG_RD32(pGpu, PCIE_GEN2_LINK_CAP2_ADDR);
+
