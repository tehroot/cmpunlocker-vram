diff -Naur a/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c b/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c
--- a/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c
+++ b/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c
@@ -4906,6 +4906,59 @@
                   GPU_REG_RD32(pGpu, 0x001fa7c4U),
                   GPU_REG_RD32(pGpu, 0x001fa7ccU));
 
+        /*
+         * PCIe Gen probe (EXPERIMENTAL).  Answers the one question doc 05 left
+         * open: can the HS-Booter arbitrary write set the LnkCap2 supported-
+         * speeds vector (0x140880a4)?  That register is PROT-walled from host
+         * MMIO (the community's "nvapoke" was blocked), but the Booter payload
+         * write runs at Heavy-Secure and may reach it.  Runs BEFORE the
+         * SS0/SS1/CFG1/LMR writes so those remain the last touches before boot
+         * and the compute/memory unlock invariant is preserved.  Does NOT
+         * retrain the link -- retrain + LnkSta verification is the safer
+         * userspace root-port step (doc 05).  Host PRIV reads below may be
+         * PROT-walled and read 0xbadfxxxx; the authoritative readback is
+         * userspace after boot:  sudo setpci -s <bdf> CAP_EXP+2c.l
+         */
+        {
+            const NvU32 pcieLnkCap    = 0x14088084U;  // LnkCap  (cfg 0x84)
+            const NvU32 pcieLnkCap2   = 0x140880a4U;  // LnkCap2 (cfg 0xa4)
+            const NvU32 pcieLnkSta    = 0x14088088U;  // LnkCtl(15:0)+LnkSta(31:16) (cfg 0x88)
+            const NvU32 pcieSpeedMask = 0x000000feU;  // supported-speeds vector, bits 7:1
+            const NvU32 pcieGen1To4   = 0x0000001eU;  // bits 4:1 = Gen1..Gen4
+            NvU32 lnkCapBefore  = GPU_REG_RD32(pGpu, pcieLnkCap);
+            NvU32 lnkCap2Before = GPU_REG_RD32(pGpu, pcieLnkCap2);
+            NvU32 lnkStaBefore  = GPU_REG_RD32(pGpu, pcieLnkSta);
+            NvU32 lnkCap2New;
+            NV_STATUS pcieStatus;
+
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PCIeProbe BEFORE: LnkCap=0x%08x LnkCap2=0x%08x "
+                      "LnkCtlSta=0x%08x (host PRIV read; 0xbadf..=PROT-walled)\n",
+                      lnkCapBefore, lnkCap2Before, lnkStaBefore);
+
+            if ((lnkCap2Before & 0xffff0000U) == 0xbadf0000U ||
+                lnkCap2Before == 0xffffffffU)
+                lnkCap2New = pcieGen1To4;  // unreadable: write the speeds field only
+            else
+                lnkCap2New = (lnkCap2Before & ~pcieSpeedMask) | pcieGen1To4;
+
+            pcieStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                pcieLnkCap2, lnkCap2New);
+            if (pcieStatus == NV_OK)
+            {
+                pcieStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                    memdescGetPhysAddr(pKernelGsp->pWprMetaDescriptor, AT_GPU, 0));
+                GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+            }
+
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PCIeProbe WRITE LnkCap2: booter=%s wrote=0x%08x "
+                      "host_readback=0x%08x (verify: setpci -s <bdf> CAP_EXP+2c.l)\n",
+                      (pcieStatus == NV_OK) ? "OK" : "FAIL", lnkCap2New,
+                      GPU_REG_RD32(pGpu, pcieLnkCap2));
+        }
+
         {
             NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
             NvU32 cfg1Value;
